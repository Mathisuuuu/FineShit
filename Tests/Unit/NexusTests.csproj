<Project Sdk="Microsoft.NET.Sdk">
  <!-- Tests numeriques du socle Nexus (ADF/MacKinnon, OU, HMM, Kelly, PBO, DSR, JSON, CSV...).
       Lancer depuis ce dossier : dotnet run -c Release   (SDK .NET et NinjaTrader 8 installes). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>13.0</LangVersion>
    <PlatformTarget>x64</PlatformTarget>
    <UseWPF>true</UseWPF>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <NoWarn>1591;0618;0612;0168;0219</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="System.Net.Http" />
    <Reference Include="NinjaTrader.Core"><HintPath>C:\Program Files\NinjaTrader 8\bin\NinjaTrader.Core.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
  <ItemGroup>
    <Compile Include="..\..\AddOns\*.cs" />
    <Compile Include="Tests.cs" />
  </ItemGroup>
</Project>
