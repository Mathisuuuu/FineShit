<Project Sdk="Microsoft.NET.Sdk">
  <!-- Banc d essai de la fiche 15 SANS NinjaTrader : la vraie classe Nexus15LetfRebalancing (et NexusStrategyBase)
       est compilee contre un emulateur minimal de l API NinjaScript (Tests\Linux\Stubs) puis executee sur des marches
       synthetiques : scenarios deterministes des regles + backtests 2011-2026 (effet LETF plante / momentum generique / bruit).
       Lancer depuis ce dossier :  dotnet run -c Release            (tout)
                                   dotnet run -c Release regles  (scenarios seulement) -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <NoWarn>1591;0618;0612;0168;0219;0108;0114;SYSLIB0014;SYSLIB0011;SYSLIB0021;SYSLIB0023</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\..\..\AddOns\*.cs" />
    <Compile Include="..\..\..\Strategies\NexusStrategyBase.cs" />
    <Compile Include="..\..\..\Strategies\Nexus15_LetfRebalancing.cs" />
    <Compile Include="..\Stubs\*.cs" />
    <Compile Include="*.cs" />
  </ItemGroup>
</Project>
