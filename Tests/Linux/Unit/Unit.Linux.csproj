<Project Sdk="Microsoft.NET.Sdk">
  <!-- Memes tests que Tests\Unit (socle Nexus + fiche 15), executables SANS NinjaTrader :
       Linux/macOS/Windows avec le SDK .NET 8.  NinjaTrader.Core est remplace par Tests\Linux\Stubs\NtCoreStub.cs.
       Lancer depuis ce dossier :  dotnet run -c Release   -> "RESULTAT : N OK, 0 ECHEC(S)" -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <InvariantGlobalization>false</InvariantGlobalization>
    <NoWarn>1591;0618;0612;0168;0219;SYSLIB0014;SYSLIB0011;SYSLIB0021;SYSLIB0023</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\..\..\AddOns\*.cs" />
    <Compile Include="..\..\Unit\Tests.cs" />
    <Compile Include="..\Stubs\NtCoreStub.cs" />
  </ItemGroup>
</Project>
